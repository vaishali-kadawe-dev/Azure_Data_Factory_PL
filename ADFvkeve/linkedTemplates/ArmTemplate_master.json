{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADFvkeve"
		},
		"LS_AzureDataLakeStorage1_VK_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_AzureDataLakeStorage1_VK'"
		},
		"LS_AzureSqlDatabase_VK_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSqlDatabase_VK'"
		},
		"LS_AzureDataLakeStorage1_VK_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsgen2vk300526.dfs.core.windows.net/"
		},
		"LS_AzureSqlDatabase_VK_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azuresqlserver300526.database.windows.net"
		},
		"LS_AzureSqlDatabase_VK_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adventurework_part2"
		},
		"LS_AzureSqlDatabase_VK_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "vkadawe"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://AzureKeyVaultVK.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADFvkeve_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureDataLakeStorage1_VK_accountKey": {
						"value": "[parameters('LS_AzureDataLakeStorage1_VK_accountKey')]"
					},
					"LS_AzureSqlDatabase_VK_password": {
						"value": "[parameters('LS_AzureSqlDatabase_VK_password')]"
					},
					"LS_AzureDataLakeStorage1_VK_properties_typeProperties_url": {
						"value": "[parameters('LS_AzureDataLakeStorage1_VK_properties_typeProperties_url')]"
					},
					"LS_AzureSqlDatabase_VK_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDatabase_VK_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDatabase_VK_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDatabase_VK_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDatabase_VK_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDatabase_VK_properties_typeProperties_userName')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}